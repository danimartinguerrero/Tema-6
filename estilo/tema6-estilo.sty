\RequirePackage[spanish,es-noshorthands,es-tabla,es-nodecimaldot]{babel}
\RequirePackage{microtype}
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage[a4paper,top=2.5cm,bottom=2.6cm,left=2.6cm,right=2.6cm,
                headheight=15pt,headsep=0.9cm]{geometry}

% ---------------------------------------------------------------- colores
\RequirePackage{xcolor}
\definecolor{fondo}{HTML}{000000}      % página
\definecolor{panel}{HTML}{0E1014}      % interior de entornos
\definecolor{panelclaro}{HTML}{16191F}
\definecolor{texto}{HTML}{ECECEC}      % texto principal
\definecolor{gristexto}{HTML}{9CA0A8}  % pies, rótulos secundarios
\definecolor{regla}{HTML}{2E3036}      % filetes
\definecolor{azul}{HTML}{5AA9E6}       % acento principal
\definecolor{azulmedio}{HTML}{447FAC}
\definecolor{azulborde}{HTML}{2C526F}  % marcos de entornos
\definecolor{celeste}{HTML}{83BEEC}
\definecolor{oro}{HTML}{D6B25E}        % acento secundario
\definecolor{naranja}{HTML}{E8894A}
\definecolor{rojo}{HTML}{E5534B}       % carga positiva
\definecolor{verdeagua}{HTML}{5AC8BE}
\definecolor{conductor}{HTML}{3A3F47}
\definecolor{conductorosc}{HTML}{1C1F24}
\definecolor{lineacampo}{HTML}{C9D1D9}

\RequirePackage{pagecolor}
\pagecolor{fondo}
\color{texto}

% ---------------------------------------------------------------- TikZ / pgfplots
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,decorations.markings,decorations.pathmorphing,
  patterns,patterns.meta,positioning,shadings,fadings,shapes.geometric,
  backgrounds,intersections,angles,quotes}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween,groupplots}
\RequirePackage{graphicx}

% Estilos gráficos comunes a todas las figuras
\tikzset{
  >={Stealth[length=4.2pt,width=3.4pt]},
  every picture/.style={line cap=round,line join=round},
  % líneas de campo (con flecha a una distancia dada del origen)
  flecha/.style={postaction={decorate},decoration={markings,
      mark=at position #1 with {\arrow{Stealth[length=3.6pt,width=3pt]}}}},
  flinea/.style={draw=lineacampo,line width=0.5pt},
  prohibida/.style={draw=rojo!80,densely dashed,line width=0.45pt,opacity=0.85},
  virtual/.style={draw=gristexto!70,dash pattern=on 1.6pt off 1.6pt,line width=0.4pt},
  equipot/.style={draw=oro,line width=0.45pt,opacity=0.85},
  equisup/.style={draw=texto,line width=0.3pt,opacity=0.45},
  % cargas
  cargapos/.style={circle,inner sep=0pt,minimum size=7.5pt,
      ball color=rojo,draw=rojo!40!black,line width=0.3pt,
      path picture={\draw[white,line width=0.7pt]
         ([xshift=-2pt]path picture bounding box.center)--([xshift=2pt]path picture bounding box.center)
         ([yshift=-2pt]path picture bounding box.center)--([yshift=2pt]path picture bounding box.center);}},
  carganeg/.style={circle,inner sep=0pt,minimum size=7.5pt,
      ball color=azul,draw=azul!40!black,line width=0.3pt,
      path picture={\draw[white,line width=0.7pt]
         ([xshift=-2pt]path picture bounding box.center)--([xshift=2pt]path picture bounding box.center);}},
  cargaimg/.style={circle,inner sep=0pt,minimum size=7pt,fill=panel,
      draw=azul,line width=0.7pt,dash pattern=on 1.2pt off 0.9pt},
  punto/.style={circle,fill=texto,inner sep=0pt,minimum size=2.6pt},
  puntoazul/.style={circle,fill=azul,inner sep=0pt,minimum size=3pt},
  menos/.style={inner sep=0pt,minimum width=3.4pt,minimum height=0.8pt,fill=azul},
  mas/.style={inner sep=0pt,minimum size=4.4pt,path picture={\draw[rojo,line width=0.75pt]
      ([xshift=-1.9pt]path picture bounding box.center)--([xshift=1.9pt]path picture bounding box.center)
      ([yshift=-1.9pt]path picture bounding box.center)--([yshift=1.9pt]path picture bounding box.center);}},
  rotulo/.style={text=texto,font=\small},
  rotulogris/.style={text=gristexto,font=\footnotesize},
  cota/.style={draw=gristexto,line width=0.35pt,{Bar[width=4pt]}-{Bar[width=4pt]}},
  cotaflecha/.style={draw=gristexto,line width=0.35pt,<->},
  eje/.style={draw=gristexto,line width=0.4pt,-{Stealth[length=4pt,width=3pt]}},
  vector/.style={draw=azul,line width=0.75pt,-{Stealth[length=5pt,width=4pt]}},
  vectororo/.style={draw=oro,line width=0.75pt,-{Stealth[length=5pt,width=4pt]}},
  vectorgris/.style={draw=texto,line width=0.6pt,-{Stealth[length=4.5pt,width=3.6pt]}},
  conductorplano/.style={top color=conductor,bottom color=fondo,draw=none},
}

% Símbolo de tierra: \tierra{(x,y)}
\newcommand{\tierra}[1]{%
  \begin{scope}[shift={#1},draw=gristexto,line width=0.6pt]
    \draw (-0.26,0)--(0.26,0); \draw (-0.17,-0.08)--(0.17,-0.08);
    \draw (-0.08,-0.16)--(0.08,-0.16);
  \end{scope}}

% Mapa de colores de la casa para pgfplots
\pgfplotsset{
  colormap={tema}{rgb255=(14,16,20) rgb255=(19,40,58) rgb255=(31,75,110)
     rgb255=(60,131,189) rgb255=(90,169,230) rgb255=(169,201,176)
     rgb255=(214,178,94) rgb255=(242,227,179)},
  oscuro/.style={
    axis line style={gristexto,line width=0.4pt},
    every tick/.style={gristexto,line width=0.3pt},
    tick label style={text=gristexto,font=\scriptsize},
    label style={text=texto,font=\small},
    title style={text=gristexto,font=\small},
    grid style={regla,line width=0.3pt},
    major grid style={regla},
    legend style={fill=panel,draw=azulborde,nodes={text=texto},font=\scriptsize,
                  rounded corners=1.5pt,inner sep=2pt},
    legend cell align=left,
    axis background/.style={fill=panel},
    tick align=outside, tick pos=left,
    every axis plot/.append style={line width=0.9pt},
    scaled ticks=false,
  },
}

