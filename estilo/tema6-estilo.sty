% ---------------------------------------------------------------- entornos (tcolorbox)
\RequirePackage[most]{tcolorbox}
\numberwithin{equation}{section}
\newcounter{entorno}[section]
\renewcommand{\theentorno}{\thesection.\arabic{entorno}}

% Caja con pestaña: \begin{definicion}[Título] ... \end{definicion}
\tcbset{
  pestana/.style={enhanced,breakable,
    colback=panel,colframe=azulborde,boxrule=0.5pt,arc=2pt,
    left=8pt,right=8pt,top=10pt,bottom=6pt,
    before skip=12pt,after skip=10pt,
    fontupper=\color{texto},
    attach boxed title to top left={xshift=6pt,yshift*=-\tcboxedtitleheight/2},
    boxed title style={colback=fondo,colframe=azulmedio,boxrule=0.5pt,arc=1.5pt,
      left=4pt,right=4pt,top=1pt,bottom=1pt},
    coltitle=azul,fonttitle=\normalfont},
}
\newcommand{\nuevoentorno}[3]{% #1 nombre, #2 rótulo, #3 fuente del cuerpo
  \newenvironment{#1}[1][]{%
    \refstepcounter{entorno}%
    \def\tcbtituloaux{##1}%
    \begin{tcolorbox}[pestana,fontupper=\color{texto}#3,
      title={\textsc{#2 \theentorno}\ifx\tcbtituloaux\empty\else\ {\color{texto}\itshape(##1)}\fi}]%
  }{\end{tcolorbox}}}
\nuevoentorno{definicion}{Definición}{}
\nuevoentorno{teorema}{Teorema}{\itshape}
\nuevoentorno{proposicion}{Proposición}{\itshape}
\nuevoentorno{lema}{Lema}{\itshape}
\nuevoentorno{corolario}{Corolario}{\itshape}
\nuevoentorno{problema}{Problema}{}
\nuevoentorno{ley}{Ley}{\itshape}

% Entornos «en línea» (sin caja), numerados con el mismo contador
\newenvironment{observacion}[1][]{\par\smallskip\refstepcounter{entorno}%
  \noindent{\color{azul}\bfseries\itshape Observación \theentorno}%
  \if\relax\detokenize{#1}\relax.\else\ {\color{gristexto}(#1)}.\fi\ }{\par\smallskip}
\newenvironment{ejemplo}[1][]{\par\smallskip\refstepcounter{entorno}%
  \noindent{\color{azul}\bfseries Ejemplo \theentorno}%
  \if\relax\detokenize{#1}\relax.\else\ {\color{gristexto}(#1)}.\fi\ }{\par\smallskip}
\newenvironment{demostracion}[1][]{\par\smallskip\noindent
  {\bfseries\itshape Demostración\if\relax\detokenize{#1}\relax\else\ #1\fi.}\ }%
  {\hfill{\color{gristexto}$\blacksquare$}\par\medskip}
\newenvironment{resolucion}{\par\smallskip\noindent
  {\color{azul}\bfseries\itshape Resolución.}\ }{\hfill{\color{gristexto}$\blacksquare$}\par\medskip}

% Bloques destacados con barra lateral: \begin{nota}{Motivación} ... \end{nota}
\newtcolorbox{nota}[1]{enhanced,breakable,colback=panel,frame hidden,
  borderline west={1.6pt}{0pt}{azul},arc=0pt,left=9pt,right=9pt,top=5pt,bottom=5pt,
  before skip=10pt,after skip=10pt,fontupper=\color{texto},
  before upper={{\color{azul}\textsc{#1}.}\ }}
\newtcolorbox{notaoro}[1]{enhanced,breakable,colback=panel,frame hidden,
  borderline west={1.6pt}{0pt}{oro},arc=0pt,left=9pt,right=9pt,top=5pt,bottom=5pt,
  before skip=10pt,after skip=10pt,fontupper=\color{texto},
  before upper={{\color{oro}\textsc{#1}.}\ }}

% Ecuaciones enmarcadas
\newcommand{\caja}[1]{\tcboxmath[enhanced,colback=panelclaro,colframe=azulmedio,
  colupper=texto,boxrule=0.5pt,arc=1.5pt,left=5pt,right=5pt,top=3pt,bottom=3pt]{#1}}

