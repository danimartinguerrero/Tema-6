%% =====================================================================
%%  tema6-estilo.sty
%%  Estilo oscuro compartido por los apuntes formalizados y el esquema
%%  simbólico del Tema 6 (Electromagnetismo I). Reproduce la estética de
%%  los apuntes de Mecánica I: fondo negro, paneles grafito, acento azul,
%%  Latin Modern, entornos tipo «pestaña» y figuras vectoriales TikZ.
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo/tema6-estilo}[2026/11/18 Estilo oscuro Tema 6]

% ---------------------------------------------------------------- tipografía
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
